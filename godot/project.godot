; Mordor 3D — Crônicas de Mordor
; Protótipo de reconstrução 3D. Renderizador compatível com Android.
config_version=5

[application]
config/name="Mordor 3D — Crônicas de Mordor"
run/main_scene="res://scenes/mordor_world.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.022, 0.02, 1)
textures/vram_compression/import_etc2_astc=true
